# RoadMate environment variables
# Copy to .env.local and fill in. NEVER commit real keys.

# --- Supabase ---
# Local dev (via `pnpm db:start`): values are printed by `pnpm db:status`.
# Cloud: from Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — used ONLY in Route Handlers (e.g. contact reveal).
# Must NOT be prefixed NEXT_PUBLIC_ and must NEVER reach the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SV (student) email badge ---
# Comma-separated whitelisted school-email domains (subdomains allowed).
SV_EMAIL_DOMAINS=edu.vn

# --- Email (optional in dev; required in prod) ---
# If unset, OTP/notification emails are logged to the server console (dev only).
RESEND_API_KEY=
EMAIL_FROM=RoadMate <onboarding@resend.dev>
