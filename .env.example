# RoadMate environment variables
# Copy to .env.local and fill in. NEVER commit real keys.

# --- Database (Postgres) ---
# Local dev (via `pnpm db:start`, see docker-compose.yml):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/roadmate
# Railway: reference the Postgres service, e.g. DATABASE_URL=${{Postgres.DATABASE_URL}}
# Optional: max connections per app instance (default 10).
# DATABASE_POOL_MAX=10

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SV (student) email badge ---
# Comma-separated whitelisted school-email domains (subdomains allowed).
SV_EMAIL_DOMAINS=edu.vn

# --- Email (optional in dev; required in prod) ---
# Used for SV-badge OTP codes and trip notifications (signup sends no email).
# If unset, emails are logged to the server console (dev only).
RESEND_API_KEY=
EMAIL_FROM=RoadMate <onboarding@resend.dev>
